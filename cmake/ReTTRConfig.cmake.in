@PACKAGE_INIT@

# ReTTR — runtime C++ reflection library
# =======================================
#
# This file is consumed by find_package(ReTTR).
# It provides the imported target::
#
#     RETTR::rettr
#
# and the compatibility alias::
#
#     rainy-juzixiao::rettr
#
# Usage example::
#
#     find_package(ReTTR REQUIRED)
#     target_link_libraries(my_app RETTR::rettr)

include("${CMAKE_CURRENT_LIST_DIR}/ReTTRTargets.cmake")

# Create the compatibility alias if it doesn't exist yet.
if(TARGET RETTR::rettr AND NOT TARGET rainy-juzixiao::rettr)
    add_library(rainy-juzixiao::rettr ALIAS RETTR::rettr)
endif()

# Validate that the installed headers are reachable.
set(_rettr_include_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
if(NOT EXISTS "${_rettr_include_dir}/rettr/rettr.hpp")
    message(WARNING
        "ReTTR headers not found at '${_rettr_include_dir}/rettr' — "
        "the package may be incomplete.  Re-run the install step.")
endif()

check_required_components(ReTTR)
